{
  "name": "orb-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "api:generate": "node scripts/generate-api-contracts.mjs",
    "api:check": "node scripts/generate-api-contracts.mjs --check",
    "lint": "eslint .",
    "preview": "vite preview",
    "refresh:smbc": "node scripts/refresh-smbc.mjs",
    "test:refresh-smbc": "node --test scripts/check-local-archives.mjs",
    "test:smbc": "npm run build && node scripts/check-smbc.mjs"
  },
  "dependencies": {
    "@smbc/devextreme-theme": "file:vendor/smbc-devextreme-theme-0.1.0.tgz",
    "@smbc/ui": "file:vendor/smbc-ui-0.1.0.tgz",
    "@tanstack/react-query": "^5.102.8",
    "devextreme": "26.1.4",
    "devextreme-react": "26.1.4",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
