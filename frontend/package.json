{
  "name": "smbc-style",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "theme:build": "node scripts/sync-devextreme-theme.mjs && devextreme build-theme --input-file src/theme/smbc-theme.metadata.json --output-file src/theme/dx.smbc.css --remove-external-resources",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "devextreme": "25.1",
    "devextreme-react": "25.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "devextreme-cli": "^1.17.0",
    "devextreme-themebuilder": "25.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
