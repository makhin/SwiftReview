<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="pdf-local" value="packages/pdf" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- Exact IDs take precedence over nuget.org's wildcard; iText 9.7 packages stay local. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="pdf-local">
      <package pattern="itext" />
      <package pattern="itext.bouncy-castle-adapter" />
      <package pattern="itext.commons" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
