<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>
    <!-- Temporary local fallback. Set to false when the approved Swift package is installed. -->
    <add key="UseMockSwiftQuery" value="true" />
    <add key="SwiftAssemblyName" value="Swift" />
    <add key="SwiftQueryTypeName" value="Swift.SwiftQuery" />
    <add key="InitialLookbackHours" value="24" />
    <add key="OverlapMinutes" value="5" />
    <add key="CommandTimeoutSeconds" value="300" />
    <add key="LogLevel" value="Information" />
    <!-- priority|bicField|bic-or-prefix*|direction(optional)|messageTypes(comma-separated)|branchId|departmentId -->
    <add key="RoutingRules" value="" />
  </appSettings>
  <connectionStrings>
    <add name="ORP" connectionString="REPLACE_WITH_PROTECTED_CONNECTION_STRING" providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
