# Local SQL Server
MSSQL_SA_PASSWORD=ORP_Strong_Passw0rd!
ConnectionStrings__ORP="Server=localhost,1433;Database=ORP;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;Encrypt=True"

# Docker uses the SQL Server service name instead of localhost.
DOCKER_CONNECTION_STRING="Server=sqlserver,1433;Database=ORP;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;Encrypt=True"

# API and Worker
InternalApiKey=development-internal-key
ApiBaseUrl=http://localhost:5080

# Frontend development server
VITE_API_PROXY_TARGET=http://localhost:5080
VITE_DEBUG_USER=supervisor
