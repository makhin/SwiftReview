# External SQL Server (Windows). Export separately for the API; this .env is used by Vite.
# Alternatively, configure ConnectionStrings:ORP using Manage User Secrets in Visual Studio.
# ConnectionStrings__ORP="Server=YOUR_SERVER;Database=ORP;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"

# API and Worker
InternalApiKey=development-internal-key
ApiBaseUrl=http://localhost:5080

# Frontend development server
VITE_API_PROXY_TARGET=http://localhost:5080
VITE_DEBUG_USER=admin
